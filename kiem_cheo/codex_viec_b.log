   461	def song_lon_nhat(nens, nhan):
   462	    ih = max(range(len(nens)), key=lambda i: nens[i].h)
   463	    il = min(range(len(nens)), key=lambda i: nens[i].l)
   464	    H, Lw = (nhan(nens[ih]), nens[ih].h), (nhan(nens[il]), nens[il].l)
   465	    return (Lw, H) if il < ih else (H, Lw)
