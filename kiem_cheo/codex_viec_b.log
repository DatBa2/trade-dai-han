   267	class Cat:
   268	    """Mọi dữ liệu của 1 buổi thi, đã cắt tại mốc C (kết thúc live). Mọi phép tính hồ sơ chỉ đọc từ đây."""
   269	
   270	    def __init__(self, du, C):
   271	        self.C = C
   272	        self.T = T = moc_h4_truoc(C)  # giờ đóng nến H4 cuối ≤ C
   273	        self.dau = []  # (tên nguồn, event_time, available_at)
   274	        self.h4 = du.h4[:bisect_right(du.dong_h4, C)]
   275	        self.d1 = du.d1[:bisect_right(du.dong_d1, C)]
   276	        self.h1 = [n for n in du.h1 if n.dong <= C][-1:]
   277	        self.gia = self.h4[-1].c
   278	        # nến đang chạy (chưa đóng tại C) dựng tạm từ các nến H4 đã đóng ≤ C
   279	        self.dang = {}
   280	        for ten, khoa in (("D1", ngay_utc), ("W1", tuan), ("MN", thang)):
   281	            bd, kt = khoa(T)
   282	            con = [n for n in self.h4 if n.mo >= bd]
   283	            self.dang[ten] = gop(con, lambda m, bd=bd, kt=kt: (bd, kt))[0][0] if con else None
   284	        # W1/tháng đã hoàn tất: gộp từ D1 đã đóng, chỉ giữ bucket kết thúc ≤ C và đủ ngày
   285	        self.w1 = [n for n, so in gop(self.d1, tuan) if n.dong <= C and so == 7]
   286	        self.mn = [n for n, so in gop(self.d1, thang) if n.dong <= C and so == (n.dong - n.mo).days]
   287	        self.fng = [x for x in du.fng if x[0] + TRE["fng"] <= C]
   288	        self.yahoo = {k: [x for x in v if x[1] + TRE["yahoo"] <= C] for k, v in du.yahoo.items()}
   289	        self.cmc = [x for x in du.cmc if x[0] + TRE["cmc"] <= C]
   290	        self.usdt = [x for x in du.usdt if x[0] + TRE["cmc"] <= C]
   291	        for ten, t in (("H4 (giờ đóng)", self.h4[-1].dong), ("D1 (giờ đóng)", self.d1[-1].dong),
   292	                       ("W1 hoàn tất (giờ đóng)", self.w1[-1].dong), ("Tháng hoàn tất (giờ đóng)", self.mn[-1].dong)):
   293	            self.dau.append((ten, t, t))
   294	        if self.h1:
   295	            self.dau.append(("H1 (giờ đóng, chỉ để báo giá gần nhất)", self.h1[-1].dong, self.h1[-1].dong))
   296	        for ten, n in self.dang.items():
   297	            if n:
   298	                t = max(x.dong for x in self.h4 if x.mo >= n.mo)
   299	                self.dau.append((f"{ten} đang chạy: nến H4 cuối gộp vào", t, t))
   300	        if self.fng: self.dau.append(("Fear & Greed (mốc ngày UTC)", self.fng[-1][0], self.fng[-1][0] + TRE["fng"]))
   301	        for k, v in self.yahoo.items():
   302	            if v: self.dau.append((f"{k} (giờ đóng phiên)", v[-1][1], v[-1][1] + TRE["yahoo"]))
   303	        if self.cmc: self.dau.append(("CMC BTC.D/tổng vốn hoá (ảnh chụp)", self.cmc[-1][0], self.cmc[-1][0] + TRE["cmc"]))
   304	        if self.usdt: self.dau.append(("CMC vốn hoá USDT (đóng ngày)", self.usdt[-1][0], self.usdt[-1][0] + TRE["cmc"]))
   305	
   306	    def kiem(self, buoi_dung, b):
   307	        for ten, t, co in self.dau:
   308	            if t > self.C or co > self.C:
   309	                raise RuntimeError(f"RÒ RỈ: {ten} {t}/{co} > C {self.C}")
   310	        for x in buoi_dung:
   311	            if x.ket_thuc > b.bat_dau or x.ten == b.ten:
   312	                raise RuntimeError(f"RÒ RỈ: buổi {x.ten} kết thúc {x.ket_thuc} sau khi buổi thi bắt đầu {b.bat_dau}")
