   156	def bat_doi_view(nguoi, may, truoc_nguoi):
   157	    """Trả về [(chỉ số buổi người đổi, nhãn mới, độ lệch bot hoặc None)]. Bot đổi sang cùng nhãn ở j, |j−i| ≤ 1."""
   158	    ra = []
   159	    for i, x in enumerate(nguoi):
   160	        cu = nguoi[i - 1] if i else truoc_nguoi
   161	        if cu is None or x == cu:
   162	            continue
   163	        lech = None
   164	        for j in (i, i - 1, i + 1):
   165	            if 0 <= j < len(may) and may[j] == x and (j == 0 or may[j - 1] != x):
   166	                lech = j - i; break
   167	        ra.append((i, x, lech))
   168	    return ra
