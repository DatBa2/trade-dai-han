   120	def doi_xung(d, bat_dau):
   121	    """Mốc phía kia cùng khoảng cách (≥ đích chặng 1 nếu đường 2 chặng); chiều chọn tới trước → THANG."""
   122	    v = tach_view(d, bat_dau) if d.get("nhan_dinh") else None
   123	    if not v or v["dich"] is None:
   124	        return None
   125	    gia, dich, huong = v["gia"], v["dich"], v["huong"]
   126	    kia = gia + abs(gia - dich) if huong == "GIAM" else gia - abs(gia - dich)
   127	    tu_c1 = False
   128	    if v["c1"] is not None and ((huong == "GIAM" and v["c1"] >= kia) or (huong == "TANG" and v["c1"] <= kia)):
   129	        kia, tu_c1 = v["c1"], True  # chạm đúng đích chặng 1 là cố ý → phải vượt hẳn mới tính thua
   130	    het = bat_dau + HAN
   131	    for t, h, l, c in cd.H1[v["i0"]:]:
   132	        if t >= het:
   133	            return "CHUA_NGA_NGU"
   134	        toi = l <= dich if huong == "GIAM" else h >= dich
   135	        kia_cham = ((h > kia) if tu_c1 else (h >= kia)) if huong == "GIAM" else ((l < kia) if tu_c1 else (l <= kia))
   136	        if toi and kia_cham:
   137	            return "CUNG_NEN"
   138	        if toi:
   139	            return "THANG"
   140	        if kia_cham:
   141	            return "THUA"
   142	    return "CHUA_HET_HAN"
   143	
