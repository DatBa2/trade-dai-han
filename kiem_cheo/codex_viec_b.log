   315	# ───────────────────────── chỉ báo ─────────────────────────
   316	def ema(xs, n):
   317	    """EMA khởi tạo bằng SMA n nến đầu; thiếu nến → None."""
   318	    if len(xs) < n:
   319	        return None
   320	    a, e = 2 / (n + 1), sum(xs[:n]) / n
   321	    ra = [e]
   322	    for x in xs[n:]:
   323	        e = a * x + (1 - a) * e; ra.append(e)
   324	    return ra
   325	
   326	
   327	def rsi(xs, n=14):
   328	    if len(xs) < n + 1:
   329	        return None
   330	    lai = [max(b - a, 0) for a, b in zip(xs, xs[1:])]
   331	    lo = [max(a - b, 0) for a, b in zip(xs, xs[1:])]
   332	    ag, al = sum(lai[:n]) / n, sum(lo[:n]) / n
   333	    for g, l in zip(lai[n:], lo[n:]):
   334	        ag, al = (ag * (n - 1) + g) / n, (al * (n - 1) + l) / n
   335	    return 100.0 if al == 0 else 100 - 100 / (1 + ag / al)
   336	
