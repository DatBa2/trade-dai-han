   449	def fibo_dong(nhan, a, b, gia):
   450	    """Sóng từ điểm a=(thời điểm, giá) đến b. Mức hồi tính ngược từ b về a."""
   451	    (ta, pa), (tb, pb) = a, b
   452	    bien = pb - pa
   453	    if bien == 0:
   454	        return f"| {nhan} | phẳng | | | | | |"
   455	    lv = {r: pb - r * bien for r in (0.382, 0.5, 0.618, 0.786)}
   456	    hoi = (pb - gia) / bien
   457	    return (f"| {nhan} | {'TĂNG' if bien > 0 else 'GIẢM'} {g(pa)} ({ta}) → {g(pb)} ({tb}) | "
   458	            + " | ".join(g(lv[r]) for r in (0.382, 0.5, 0.618, 0.786)) + f" | {hoi:.3f} |")
   459	
