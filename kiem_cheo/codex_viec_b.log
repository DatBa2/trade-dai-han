   658	              f"{vn(x.ket_thuc, '%H:%M')} VN{'' if x.chac else ' (giờ không chắc)'}")
   659	    ngay_C = cat.C.astimezone(VN).strftime("%Y-%m-%d")
   660	    than = "\n".join(l for l in noi_dung.splitlines() if not l.startswith(("# Hồ sơ buổi thi", "- Giờ live:")))
   661	    sau = sorted({d for d in re.findall(r"\b(20\d\d-\d\d-\d\d)\b", than) if d > ngay_C})
   662	    print(f"   ngày ISO > ngày C ({ngay_C}) trong hồ sơ (trừ tiêu đề + dòng giờ live): {sau or 'không có'}")
