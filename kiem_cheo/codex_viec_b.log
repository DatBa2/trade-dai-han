   145	# ───────────────────────── thống kê ─────────────────────────
   146	def p_nhi_thuc(k, n):
   147	    if n == 0:
   148	        return 1.0
   149	    return min(1.0, 2 * sum(math.comb(n, i) for i in range(0, min(k, n - k) + 1)) / 2 ** n)
   150	
   151	
   152	def ty_le(a, b):
   153	    return f"{a}/{b} = {a / b:.0%}" if b else "—"
   154	
