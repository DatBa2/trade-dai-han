   190	    gio = b.bat_dau.astimezone(hs.VN).hour
   191	    return ("Live sáng (06–14h VN)" if 6 <= gio < 14 else "Live tối/đêm"), ("Giờ live thật" if b.chac else "Giờ không chắc")
