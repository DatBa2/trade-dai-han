   110	def cham_thi_truong(d, bat_dau):
   111	    if not d.get("nhan_dinh"):
   112	        return "KHONG_VIEW", None
   113	    kq, luc = cd.cham(d, bat_dau)
   114	    het_du_lieu = cd.H1[-1][0] + dt.timedelta(hours=1)
   115	    if kq in ("CHUA_RO", "SAI_HET_HAN", "CHUA_DU_LIEU") and bat_dau + HAN > het_du_lieu:
   116	        kq = "CHUA_HET_HAN"
   117	    return kq, luc
   118	
