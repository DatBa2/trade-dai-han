   562	def trang_thai_moc(m, nens, gia_noi, gia_T):
   563	    if not isinstance(m.get("gia"), (int, float)):
   564	        return "không có số giá"
   565	    lo, hi = sorted([m["gia"], m["gia_tren"] if isinstance(m.get("gia_tren"), (int, float)) else m["gia"]])
   566	    vi_tri = "giá T trên vùng" if gia_T > hi else ("giá T dưới vùng" if gia_T < lo else "giá T trong vùng")
   567	    if not nens:
   568	        return f"chưa có nến H4 đóng sau lúc nói · {vi_tri}"
   569	    cmax, cmin = max(n.c for n in nens), min(n.c for n in nens)
   570	    hmax, lmin = max(n.h for n in nens), min(n.l for n in nens)
   571	    cham = lmin <= hi and hmax >= lo
   572	    vt, hg = m.get("vai_tro"), m.get("huong")
   573	    tren = (lo > gia_noi) if isinstance(gia_noi, (int, float)) else (hg == "GIAM")  # mốc nằm trên giá lúc nói?
   574	    if vt in ("ho_tro", "day_cu"):
   575	        s = f"ĐÃ PHÁ (đóng H4 thấp nhất {g(cmin)})" if cmin < lo else ("giữ, đã test" if cham else "giữ, chưa test")
   576	    elif vt in ("khang_cu", "dinh_cu"):
   577	        s = f"ĐÃ PHÁ (đóng H4 cao nhất {g(cmax)})" if cmax > hi else ("giữ, đã test" if cham else "giữ, chưa test")
   578	    elif vt == "vo_hieu":
   579	        if tren:
   580	            s = f"ĐÃ KÍCH HOẠT (đóng H4 cao nhất {g(cmax)})" if cmax > lo else "chưa kích hoạt"
   581	        else:
   582	            s = f"ĐÃ KÍCH HOẠT (đóng H4 thấp nhất {g(cmin)})" if cmin < hi else "chưa kích hoạt"
   583	    elif vt == "dich":
   584	        s = ("ĐÃ TỚI" if (hmax >= lo if tren else lmin <= hi) else "chưa tới")
   585	    else:
   586	        s = "đã chạm" if cham else "chưa chạm"
   587	    return f"{s} · {vi_tri}"
   588	
