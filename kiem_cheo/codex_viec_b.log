   190	            try:
   191	                bd = dt.datetime.strptime(r["bat_dau_vn"].strip(), "%Y-%m-%d %H:%M").replace(tzinfo=VN).astimezone(UTC)
   192	                that[r["id"]] = (bd, int(r["phut"]), r.get("nguon_gio") or "?")
   193	            except (KeyError, ValueError, TypeError):
