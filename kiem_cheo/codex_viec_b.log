   256	def gop(nens, khoa):
   257	    ra = []
   258	    for n in nens:
   259	        bd, kt = khoa(n.mo)
   260	        if ra and ra[-1][0] == bd:
   261	            x = ra[-1]; x[3] = max(x[3], n.h); x[4] = min(x[4], n.l); x[5] = n.c; x[6] += 1
   262	        else:
   263	            ra.append([bd, kt, n.o, n.h, n.l, n.c, 1])
   264	    return [(Nen(*x[:6]), x[6]) for x in ra]
