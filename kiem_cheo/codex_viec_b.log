    79	# ───────────────────────── tách đích / mốc sai (cùng logic cd.cham) ─────────────────────────
    80	def gia_luc(bat_dau):
    81	    i0 = bisect_left(cd.T1, bat_dau)
    82	    return (cd.H1[i0 - 1][3] if i0 else cd.H1[0][3]) if i0 < len(cd.H1) else None, i0
    83	
    84	
    85	def tach_view(d, bat_dau):
    86	    n = (d.get("nhan_dinh") or [{}])[0]; huong = n.get("huong")
    87	    if huong not in ("TANG", "GIAM"):
    88	        return None
    89	    dich = (n.get("duong_di") or [{}])[-1].get("dich") if n.get("duong_di") else n.get("dich")
    90	    if isinstance(dich, list):
    91	        dich = [x for x in dich if isinstance(x, (int, float))]
    92	        dich = (max(dich) if huong == "GIAM" else min(dich)) if dich else None
    93	    gia, i0 = gia_luc(bat_dau)
    94	    if not isinstance(dich, (int, float)) or gia is None or (huong == "GIAM" and dich >= gia) or (huong == "TANG" and dich <= gia):
    95	        dich = None
    96	    c1 = None
    97	    dd = n.get("duong_di") or []
    98	    if len(dd) >= 2 and dd[0].get("huong") not in (huong, None):
    99	        x = dd[0].get("dich"); x = [v for v in (x if isinstance(x, list) else [x]) if isinstance(v, (int, float))]
   100	        if x and gia:
   101	            c1 = max(x) if huong == "GIAM" else min(x)
   102	    nguong = gia if c1 is None else (max(c1, gia) if huong == "GIAM" else min(c1, gia))
   103	    vh = n.get("vo_hieu_khi") or ""
   104	    bat_loi = [] if re.search(r"\bM(5|15|30)\b|\b(5|15|30) phút|\bH1\b|scalp", vh, re.I) or nguong is None else \
   105	        [v for v in cd.so_trong(vh) if (v > nguong if huong == "GIAM" else v < nguong)]
   106	    moc_sai = (min(bat_loi) if huong == "GIAM" else max(bat_loi)) if bat_loi else None
   107	    return {"huong": huong, "dich": dich, "gia": gia, "i0": i0, "c1": c1, "moc_sai": moc_sai}
