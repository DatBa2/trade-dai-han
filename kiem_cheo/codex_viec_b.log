   590	def bang_moc(b, cat):
   591	    if not b.moc:
   592	        return "_Không có file mốc._"
   593	    d = doc_json(b.moc)
   594	    nens = [n for n in cat.h4 if n.dong > b.bat_dau]
   595	    rows = [f"Bản đồ mốc (giá lúc nói ~{g(d.get('gia_btc_luc_noi'))}; trạng thái tính bằng {len(nens)} nến H4 ĐÓNG từ lúc nói tới C — "
   596	            "phá = giá đóng H4 vượt mốc, chạm/tới = râu chạm):",
   597	            "| Giá | Vai trò | Hướng | Khung | Căn cứ | Tới C |", "|---|---|---|---|---|---|"]
   598	    for m in d.get("moc", []):
   599	        gia = g(m.get("gia")) + (f"–{g(m['gia_tren'])}" if m.get("gia_tren") else "")
   600	        cc = "; ".join(m.get("can_cu") or [])
   601	        rows.append(f"| {gia} | {VAI_TRO.get(m.get('vai_tro'), m.get('vai_tro'))}{'' if m.get('chac', True) else ' (?)'} | "
   602	                    f"{m.get('huong') or '—'} | {m.get('khung') or '—'} | {cc.replace('|', '/')} | "
   603	                    f"{trang_thai_moc(m, nens, d.get('gia_btc_luc_noi'), cat.gia)} |")
   604	    return "\n".join(rows)
