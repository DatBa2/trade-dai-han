   420	         f"Lịch sử dùng: H4 từ {cat.h4[0].mo:%Y-%m-%d} ({len(cat.h4)} nến), D1 từ {cat.d1[0].mo:%Y-%m-%d} ({len(cat.d1)} nến), "
   421	         f"W1 {len(cat.w1)} nến hoàn tất."]
   422	    for khung, nens in (("H4", cat.h4), ("D1", cat.d1), ("W1", cat.w1)):
   423	        c, h, l = [n.c for n in nens], [n.h for n in nens], [n.l for n in nens]
   424	        dg = {"EMA34 high": ema(h, 34), "EMA34 low": ema(l, 34), "EMA34 close": ema(c, 34),
   425	              "EMA89": ema(c, 89), "EMA200": ema(c, 200), "EMA610": ema(c, 610)}
   426	        L += [f"### {khung}", "| Đường | Giá trị | Giá T so với đường | Dốc 5 nến |", "|---|---|---|---|"]
   427	        for ten, s in dg.items():
   428	            if s is None:
   429	                L.append(f"| {ten} | không đủ ({len(nens)} nến < {ten.split()[0][3:]}) | — | — |"); continue
   430	            v = s[-1]
   431	            doc_ = (s[-1] / s[-6] - 1) * 100 if len(s) >= 6 else None
   432	            L.append(f"| {ten} | {g(v)} | {'trên' if cat.gia > v else 'dưới'} {pct((cat.gia / v - 1) * 100)} | {pct(doc_)} |")
   433	        if dg["EMA34 high"]:
   434	            hi, lo = dg["EMA34 high"][-1], dg["EMA34 low"][-1]
   435	            vt = "TRÊN dải" if cat.gia > hi else ("DƯỚI dải" if cat.gia < lo else "TRONG dải")
   436	            L.append(f"- Dải EMA34 (low–high) {g(lo)}–{g(hi)}: giá **{vt}**")
   437	        co = {k: dg[k][-1] for k in ("EMA34 close", "EMA89", "EMA200", "EMA610") if dg[k]}
   438	        if len(co) >= 3:
   439	            ba = [co[k] for k in ("EMA34 close", "EMA89", "EMA200") if k in co]
   440	            gian = (max(ba) - min(ba)) / cat.gia * 100
   441	            L.append(f"- Độ chụm EMA34/89/200 = (max−min)/giá = **{gian:.2f}%** → "
   442	                     f"{'**CHỤM**' if gian < NGUONG_CHUM[khung] else 'không chụm'} (ngưỡng tham khảo {khung} < {NGUONG_CHUM[khung]}%)")
   443	            thu_tu = sorted(co, key=co.get, reverse=True)
   444	            L.append("- Thứ tự từ trên xuống: " + " > ".join(f"{k.replace(' close', '')}" for k in thu_tu)
   445	                     + f" · giá đang ở vị trí {sum(cat.gia < v for v in co.values()) + 1}/{len(co) + 1} (1 = trên cùng)")
