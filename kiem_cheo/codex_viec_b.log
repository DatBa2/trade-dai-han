   171	# ───────────────────────── chính ─────────────────────────
   172	def chi_so(v, ng):
   173	    """v: nhãn dự đoán (có thể None = không có nhãn, tính là sai); ng: nhãn người đó."""
   174	    n = len(ng)
   175	    f1, rec = [], []
   176	    for c in NHAN:
   177	        tp = sum(1 for x, y in zip(v, ng) if x == c and y == c)
   178	        fp = sum(1 for x, y in zip(v, ng) if x == c and y != c)
   179	        fn = sum(1 for x, y in zip(v, ng) if x != c and y == c)
   180	        f1.append(2 * tp / (2 * tp + fp + fn) if 2 * tp + fp + fn else 0.0)
   181	        if tp + fn:
   182	            rec.append(tp / (tp + fn))
   183	    po = sum(x == y for x, y in zip(v, ng)) / n
   184	    nh = set(v) | set(ng)
   185	    pe = sum(sum(1 for x in v if x == c) * sum(1 for y in ng if y == c) for c in nh) / n ** 2
   186	    return {"f1": sum(f1) / 3, "bacc": sum(rec) / len(rec) if rec else None, "kappa": None if pe == 1 else (po - pe) / (1 - pe)}
   187	
