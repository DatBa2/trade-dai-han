    43	# ───────────────────────── chuẩn hoá ─────────────────────────
    44	def chuan_huong(x):
    45	    if x is None:
    46	        return None
    47	    s = unicodedata.normalize("NFD", str(x)).encode("ascii", "ignore").decode().upper().strip().replace(" ", "_")
    48	    if s in ("TANG", "LONG", "UP"): return "TANG"
    49	    if s in ("GIAM", "SHORT", "DOWN"): return "GIAM"
    50	    if s.replace("_", "") in ("PHANVAN", "PV", "DUNGNGOAI", "TRUNGLAP", "SIDEWAY"): return "PHAN_VAN"
    51	    return None
    52	
    53	
    54	def chuan_so(x):
    55	    """'82000' → '82.000' để cd.so_trong đọc được (nó chỉ nhận dạng 82.000 / 82k / 82)."""
    56	    return re.sub(r"(?<![\d.,])(\d{2,3})(\d{3})(?![\d.,])", r"\1.\2", x) if isinstance(x, str) else (
    57	        chuan_so(f"{x:.0f}") if isinstance(x, (int, float)) else x)
    58	
