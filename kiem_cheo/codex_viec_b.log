   338	def fractal(nens, k, tu):
   339	    ra = []
   340	    for i in range(k, len(nens) - k):
   341	        n = nens[i]
   342	        if n.mo < tu:
   343	            continue
   344	        if all(n.h > nens[j].h for j in range(i - k, i)) and all(n.h >= nens[j].h for j in range(i + 1, i + k + 1)):
   345	            ra.append((i, "đỉnh", n.h))
   346	        if all(n.l < nens[j].l for j in range(i - k, i)) and all(n.l <= nens[j].l for j in range(i + 1, i + k + 1)):
   347	            ra.append((i, "đáy", n.l))
   348	    return ra
