    60	def chuan_bai(d):
    61	    """Bài làm/phiếu → dạng phiếu mà cd.cham hiểu; chỉ giữ 1 view H4 (hoặc chung)."""
    62	    d = json.loads(json.dumps(d))
    63	    for n in d.get("nhan_dinh") or []:
    64	        n["huong"] = chuan_huong(n.get("huong"))
    65	        k = str(n.get("khung") or "").upper()
    66	        n["khung"] = {"4H": "H4", "CHUNG": "chung", "1D": "D1", "1W": "W1"}.get(k, n.get("khung"))
    67	        n["vo_hieu_khi"] = chuan_so(n.get("vo_hieu_khi"))
    68	        for k2 in ("duong_di",):
    69	            n.setdefault(k2, None)
    70	    for l in d.get("lenh") or []:
    71	        l.setdefault("trang_thai", "de_xuat_moi")
    72	        c = chuan_huong(l.get("chieu"))
    73	        l["chieu"] = {"TANG": "LONG", "GIAM": "SHORT"}.get(c, l.get("chieu"))
    74	    v = hs.huong_h4(d)
    75	    d["nhan_dinh"] = [v] if v else []
    76	    return d, (v.get("huong") if v else None)
    77	
