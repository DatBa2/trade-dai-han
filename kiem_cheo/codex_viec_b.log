   607	def dong_nd(x):
   608	    p = [f"**[{x.get('khung')}] {x.get('huong')}** (chắc: {x.get('do_chac')})"]
   609	    for k, nhan in (("dich", "đích"), ("han", "hạn"), ("vo_hieu_khi", "vô hiệu khi"), ("kich_ban_phu", "kịch bản phụ")):
   610	        if x.get(k) not in (None, "", []):
   611	            p.append(f"{nhan}: {x[k]}")
   612	    if x.get("ly_do"):
   613	        p.append("lý do: " + "; ".join(x["ly_do"]))
   614	    if x.get("trich"):
   615	        p.append(f"trích: “{x['trich']}”")
   616	    return "- " + " · ".join(p)
