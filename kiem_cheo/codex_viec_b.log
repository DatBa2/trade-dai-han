   369	def bang_nen(ds, nhan):
   370	    rows = ["| Nến | O | H | L | C | Thân % | Râu trên % | Râu dưới % | Biên % |", "|---|---|---|---|---|---|---|---|---|"]
   371	    for n, dang in ds:
   372	        than = (n.c - n.o) / n.o * 100
   373	        rows.append(f"| {nhan(n)}{' (đang chạy, tới T)' if dang else ''} | {g(n.o)} | {g(n.h)} | {g(n.l)} | {g(n.c)} | "
   374	                    f"{pct(than)} | {(n.h - max(n.o, n.c)) / n.o * 100:.2f}% | {(min(n.o, n.c) - n.l) / n.o * 100:.2f}% | "
   375	                    f"{(n.h - n.l) / n.o * 100:.2f}% |")
   376	    return "\n".join(rows)
