   558	VAI_TRO = {"ho_tro": "hỗ trợ", "khang_cu": "kháng cự", "dich": "đích", "entry": "vào lệnh", "tp": "TP", "sl": "SL",
   559	           "vo_hieu": "vô hiệu", "khac": "khác", "nhac_lai": "nhắc lại", "day_cu": "đáy cũ", "dinh_cu": "đỉnh cũ"}
