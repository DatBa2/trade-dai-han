   654	    print(f"   nến H4 cuối mở {vn(cat.h4[-1].mo)} · D1 cuối mở {cat.d1[-1].mo:%Y-%m-%d} · "
   655	          f"W1 cuối mở {cat.w1[-1].mo:%Y-%m-%d} · tháng cuối {cat.mn[-1].mo:%Y-%m}")
   656	    for x in dung:
