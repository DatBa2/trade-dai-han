   509	        cuc = sau[j].l if l2 == "đỉnh" else sau[j].h
   510	        L.append(fibo_dong(f"Nhịp H4 đang chạy (từ {l2} fractal cuối)", (nh(cat.h4[i2]), p2), (nh(sau[j]), cuc), cat.gia))
   511	    # động lượng
