   202	        m = MAU_TEN.match(q.stem)
   203	        if not m:
   204	            print(f"! bỏ qua tên lạ: {q.name}", file=sys.stderr); continue
   205	        ngay, hhmm, vid = m.groups()
   206	        if vid in that:
   207	            bd, ph, nguon = that[vid]; chac = True
   208	        else:
   209	            bd = dt.datetime.strptime(ngay + (hhmm or "1000"), "%Y-%m-%d%H%M").replace(tzinfo=VN).astimezone(UTC)
   210	            ph, nguon, chac = phut.get(vid, PHUT_MAC_DINH), ("tên file" if hhmm else "mặc định 10:00"), False
   211	        C = bd + dt.timedelta(minutes=ph)
   212	        ra.append(Buoi(q.stem, ngay, hhmm, vid, bd, C, C, moc_h4_truoc(C), q, mocs.get(vid), chac, nguon))
   213	    ra.sort(key=lambda b: (b.bat_dau, b.ten))
   214	    return ra
