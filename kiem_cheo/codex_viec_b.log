    for t in sorted(thang):
        c = thang[t]; n = c["DUNG"] + c["SAI"] + c["SAI_HET_HAN"]
        print(f"  {t}: đúng {c['DUNG']}/{n}" + (f" = {c['DUNG'] / n:.0%}" if n else "") + f" · phân vân {c['PHAN_VAN']} · chưa rõ {c['CHUA_RO']}")


if __name__ == "__main__":
    main()

